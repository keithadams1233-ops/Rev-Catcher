# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — server-only, never exposed to the client bundle.
# Used by scripts/seed.ts and future server-only pipelines (CSV import,
# metric engine, ledger writers).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
